# Copy this file to api/.env. Never commit api/.env or real secrets.

# SpinalHub connection
ORGAN_NAME="Spinal-organ-auth"          # Display name; the default is suitable in most installations.
SPINAL_USER_ID="admin"                  # SpinalHub account used by this organ.
SPINAL_PASSWORD="change-me"             # Password of SPINAL_USER_ID.
SPINALHUB_IP="127.0.0.1"                # Hostname or IP only, without http://.
SPINALHUB_PORT="7777"                   # SpinalHub TCP port.
SPINAL_DTWIN_PATH=""                    # Optional digital-twin path; leave empty when unused.

# Authentication secrets
# Use independent random values. `openssl rand -base64 48` is suitable.
# npm run build generates missing TOKEN_SECRET, SESSION_SECRET, AUTH_ADMIN_PASSWORD
# and REGISTER_KEY values, but explicit secret-manager values are preferred in production.
TOKEN_SECRET=""                         # Signs JWTs; keep stable or all existing tokens become invalid.
SESSION_SECRET=""                       # Signs Express session cookies; use a different value from TOKEN_SECRET.
AUTH_ADMIN_PASSWORD=""                  # Initial authAdmin password; must satisfy the password policy.
REGISTER_KEY=""                         # Secret used when registering platforms.
TOKEN_BOS_ADMIN=""                      # Optional BOS administrator token; leave empty when unused.

# Brute-force protection
MAX_LOGIN_ATTEMPTS="5"                  # Positive integer; failed logins before temporary lockout.
ACCOUNT_LOCK_DURATION_MINUTES="15"      # Positive integer; automatic lockout duration.

# API and logs
REQUESTS_PORT="3000"                    # Port exposed by the API process.
LIMIT_LOG="3000"                        # Maximum number of retained logs.

# Transport
SERVER_PROTOCOL="http"                  # Use http locally; use https in production without a TLS reverse proxy.
SSL_CERT_PATH=""                        # Required only when SERVER_PROTOCOL=https.
SSL_KEY_PATH=""                         # Required only when SERVER_PROTOCOL=https.
NODE_TLS_REJECT_UNAUTHORIZED="1"        # Keep 1 in production; 0 is only for local self-signed certificates.

# Browser cookie authentication
# Leave CORS_ORIGINS empty when Vue and the API use the same origin.
# Otherwise list exact browser origins, comma-separated, without a trailing slash.
CORS_ORIGINS=""


# false: local HTTP only. true: production HTTPS and all SameSite=none deployments.
# Leave empty to infer the value from SERVER_PROTOCOL.
AUTH_COOKIE_SECURE=""

# lax: default for same-origin or same-site deployments.
# strict: strongest isolation, only when no cross-site authentication redirect is required.
# none: Vue and API on different sites; requires HTTPS and AUTH_COOKIE_SECURE=true.
AUTH_COOKIE_SAME_SITE="lax"
